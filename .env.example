# Copia in .env.local e inserisci i valori del tuo progetto.
# NON committare .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — SOLO server (signed URL creatività approval).
# NON usare prefisso NEXT_PUBLIC. NON committare valori reali.
SUPABASE_SERVICE_ROLE_KEY=

# Meta — SOLO server. Nessun prefisso NEXT_PUBLIC. Non committare valori reali.
# Assenti in locale: l'app resta usabile; le funzioni Meta falliscono in modo sicuro.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_REDIRECT_URI=
# 32 byte: 64 hex chars oppure base64. Usata per AES-256-GCM dei token.
META_TOKEN_ENCRYPTION_KEY=
META_GRAPH_API_VERSION=

# Anthropic — solo server (API routes). Opzionale in locale.
# Senza chiave le route AI restituiscono errore configurazione (niente fake success).
ANTHROPIC_API_KEY=
# Opzionale: override model ID (default server: claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5
