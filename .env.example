# Copia in .env.local e inserisci i valori del tuo progetto.
# NON committare .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — SOLO server (signed URL creatività approval).
# NON usare prefisso NEXT_PUBLIC. NON committare valori reali.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — solo server (API routes). Opzionale in locale.
# Senza chiave le route AI restituiscono errore configurazione (niente fake success).
ANTHROPIC_API_KEY=
# Opzionale: override model ID (default server: claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5
